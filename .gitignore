.tooling/android-downloads/
.tooling/android-sdk/
.tooling/android-user-home/
.tooling/flutter/
.tooling/go/
.tooling/gradle-home/
.tooling/jdk-17/
.tooling/postman-runtime/
.tooling/api-validation/node_modules/

# Agent operational memory
.remember/

# Flutter / Dart build artifacts & cache
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/

# Android build outputs, caches & binaries
*.apk
*.aab
*.so
.gradle/
**/android/.gradle/
**/android/local.properties
**/local.properties
**/debug.keystore*

# Go build outputs
*.exe
*.test
*.prof

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~
